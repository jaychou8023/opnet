#!/bin/sh
# OpNet 卸载脚本：停隧道 + 删除本机客户端与日志
# 按设计【不动 sshd】——sshd 是系统组件，关掉它可能会切断你当前的 SSH 会话
# 用法: curl -fsSL {{PUBLIC_BASE}}/i/{{KEY}}/uninstall.sh | sudo bash
set -eu

WANT_PORT="{{WANT_PORT}}"
MACHINE="{{NAME}}"
WORK=/opt/opnet-client

RED='\033[1;31m'; GREEN='\033[1;32m'; NC='\033[0m'
log() { printf "${GREEN}[opnet]${NC} %s\n" "$*"; }
die() { printf "${RED}[opnet]${NC} %s\n" "$*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "需要 root：请用 sudo bash 运行"

log "卸载机器 ${MACHINE}（映射端口 ${WANT_PORT}）"

# 1) 停隧道进程
PIDS=$(pgrep -f "opnet-client.*-wantport ${WANT_PORT}" 2>/dev/null || true)
if [ -n "$PIDS" ]; then
  log "停止隧道进程 (pid: $(echo $PIDS | tr '\n' ' '))"
  kill $PIDS 2>/dev/null || true
  sleep 1
  PIDS=$(pgrep -f "opnet-client.*-wantport ${WANT_PORT}" 2>/dev/null || true)
  if [ -n "$PIDS" ]; then
    log "仍在运行，强制结束"
    kill -9 $PIDS 2>/dev/null || true
  fi
else
  log "隧道本来就没在运行"
fi

# 2) 删客户端与日志
if [ -d "$WORK" ]; then
  log "删除 $WORK"
  rm -rf "$WORK"
else
  log "$WORK 不存在，跳过"
fi

OS=$(uname -s)
cat <<EOF

========================================
 已卸载
   隧道进程  : 已停止，服务端端口 ${WANT_PORT} 已释放
   客户端文件: 已删除（${WORK}）
----------------------------------------
 未改动（按设计保留）：
   sshd 仍在运行，且仍是开机自启
   如需一并关闭，请手动执行（注意：会切断你当前的 SSH 会话）：
     Linux : systemctl disable --now ssh
     macOS : sudo launchctl disable system/com.openssh.sshd
========================================
EOF
